# ==========================================
# ReachInbox Email Scheduler Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reachinbox
POSTGRES_PORT=5432

# Redis Configuration (BullMQ & Rate Limiting)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session Security
SESSION_SECRET=reachinbox_dev_session_secret_change_in_production_32chars

# Email Worker Settings
WORKER_CONCURRENCY=5
DEFAULT_HOURLY_LIMIT=50
DEFAULT_DELAY_MS=2000

# Ethereal SMTP (Default / Fallback)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="ReachInbox Demo"
SMTP_FROM_EMAIL="demo@reachinbox.test"

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:5000
