# =============================================================================
# ReachInbox Environment Configuration
# =============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Frontend URL (For CORS and OAuth redirects)
# Local: http://localhost:3000
# Production: https://reachinbox.adityak.tech
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16)
# Local Docker: postgresql://postgres:postgres@localhost:5432/reachinbox
# Production: e.g. postgresql://postgres:password@host:port/reachinbox
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

# Redis Configuration (BullMQ Queue)
# Local Docker: redis://localhost:6379
# Production: e.g. redis://default:password@host:port
REDIS_URL=redis://localhost:6379

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Local: http://localhost:5000/api/auth/google/callback
# Production: https://api.reachinbox.adityak.tech/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session JWT Secret (Use a secure random 32+ character string)
SESSION_SECRET=reachinbox_secret_key_minimum_32_characters_long

# Worker & Queue Rate Limiting Configuration
WORKER_CONCURRENCY=5
DEFAULT_HOURLY_LIMIT=50
DEFAULT_DELAY_MS=2000

# Ethereal Email Fake SMTP (Leave blank to auto-generate ephemeral test accounts)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Frontend Environment Variable (used by Next.js client)
# Local: http://localhost:5000
# Production: https://api.reachinbox.adityak.tech
NEXT_PUBLIC_API_URL=http://localhost:5000
